---
import type { Publication } from '../data/publications';
import { profile } from '../data/profile';
interface Props { publication: Publication; }
const { publication } = Astro.props;
const resource = publication.paper ?? publication.conference;
---
<article class:list={['publication-entry', { 'with-figure': publication.figure }]}>
  {publication.figure && <a class="publication-figure" href={publication.figure.src} target="_blank" rel="noopener noreferrer" aria-label="View the full-size SYCLE scientific figure (opens in a new tab)">
    <img src={publication.figure.src} alt={publication.figure.alt} width={publication.figure.width} height={publication.figure.height} decoding="async" />
  </a>}
  <div class="publication-citation">
    <h3 class="publication-title">{publication.title}</h3>
    <p class="authors">{publication.authors.map((author, index) => <>{index > 0 && ', '}{author === profile.name ? <strong>{author}</strong> : author}{publication.equalContributionAuthors?.includes(author) && <sup>*</sup>}</>)}</p>
    <p class="publication-status"><span class="publication-venue">{publication.venue}</span> · {publication.status}</p>
    <p class="publication-resource"><a href={resource.href}>{publication.paper ? 'paper' : resource.label}</a></p>
  </div>
</article>
